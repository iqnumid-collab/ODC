flowchart LR
  subgraph serverPipe["odc-root on hexa-five"]
    tm["tunnel-manager"]
    rm["registry-manager"]
    tm -->|"IPC notify\ntunnel.*"| rm
    rm -->|"HTTP"| wh["webhooks"]
  end

  subgraph hookPipe["odc-hook on molt — REQUIRED"]
    hook["odc-hook\nEventBus + ThreadPool"]
    mon["odc-cli hook status\ndev-host monitor"]
    rm -->|"WSS publish"| hook
    mon -->|"hook.sock"| hook
  end

  subgraph onboardPipe["odc-onboard-v2 on Pi"]
    vpn["VPN Connected"]
    trig["graph triggers"]
    mav["MAV extender"]
    rtsp["RTSP compressor"]
    vpn --> trig
    trig --> mav
    trig --> rtsp
  end

  subgraph orchPipe["molt orchestrator"]
    build["build"]
    dep["deploy"]
    check["health + hook checks"]
    e2e["E2E scripts"]
    build --> dep --> check --> e2e
  end

  vpn -.->|"peer up"| tm
  hook -.->|"assert events"| e2e
  mav -.->|"assert traffic"| e2e
  rtsp -.->|"assert frames"| e2e
