flowchart TD
  PRE["ATT preflight"] --> CEL["ODC-DEV-CEL<br/>cellular.qmi only"]
  CEL --> VPN["ODC-DEV-VPN<br/>vpn.* only"]
  VPN --> MAV["ODC-DEV-MAV<br/>Phases A/B router-only<br/>Phases C/D + VPN extender"]
  MAV --> VID["ODC-DEV-VID<br/>rtsp.compressor only"]
  VID --> REST["Restore full system.yaml<br/>optional full E2E later"]

  CEL -.->|forbidden| X1["no VPN / MAV / RTSP"]
  VPN -.->|forbidden| X2["no MAV extender / RTSP"]
  MAV -.->|Phases A/B| X3["no live VPN / RTSP"]
  MAV -.->|Phases C/D after VPN| X3b["VPN + extender allowed"]
  VID -.->|forbidden| X4["no VPN / MAV / cellular"]
