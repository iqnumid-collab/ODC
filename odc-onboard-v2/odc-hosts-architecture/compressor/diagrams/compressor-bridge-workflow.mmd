sequenceDiagram
  participant Molt as molt
  participant SrcHost as source_host
  participant DUT as compressor_DUT
  participant MonHost as monitor_host

  Molt->>DUT: apply fixture input_host equals source LAN IP
  Molt->>DUT: bind listen 0.0.0.0 output_port 8555
  Molt->>SrcHost: start odc-video-source on LAN :8554
  Molt->>DUT: graph components start rtsp_lab
  Note over DUT: ingest rtsp://SrcHost:8554/stream
  Molt->>MonHost: odc-rtsp-monitor rtsp://DUT:8555/stream
  MonHost-->>Molt: BW frames greater than 0
  Molt->>MonHost: assert codec resolution match fixture
  Molt->>DUT: subscribe events ClientConnected from remote client
  Molt->>SrcHost: kill source
  DUT-->>Molt: SourceLost
  Molt->>SrcHost: restart source
  DUT-->>Molt: SourceRecovered
  MonHost-->>Molt: BW restored
  Molt->>DUT: teardown
  Molt->>SrcHost: stop source
  Molt->>MonHost: stop monitor
