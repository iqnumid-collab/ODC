flowchart LR
  subgraph molt [molt]
    Orch["Orchestrate suite"]
    SrcOpt["Optional source :8554"]
    MonOpt["Optional monitor"]
    Ev["Archive evidence"]
    Orch --> SrcOpt
    Orch --> MonOpt
    Orch --> Ev
  end

  subgraph eachDut [each_Pi]
    Tools["local source and monitor"]
    Daemon["odc-onboard-v2 compressor"]
    Lan["eth0 192.168.10.x\nlisten and ingest"]
    Tools --- Daemon
    Daemon --- Lan
  end

  subgraph hexa [hexa_five]
    HexMon["Optional remote monitor"]
  end

  molt -->|"SSH control"| eachDut
  SrcOpt -->|"LAN RTSP"| eachDut
  eachDut -->|"LAN RTSP"| MonOpt
  eachDut -->|"LAN RTSP peer"| eachDut
  eachDut -.->|"LAN RTSP"| HexMon
