# Copy to real_hardware.env and customize for your lab.
# source tests/helpers/real_hardware.env before running test_graph_real_hardware_e2e.sh

# Persistent graph config (survives between runs)
export ODC_CONFIG=/var/lib/odc-test/system.yaml
export ODC_SOCKET=/run/odc-test/odc-onboard.sock

# hexa-five lab VPN (management host 192.168.10.16; WG 192.168.10.201; OpenVPN 192.168.10.202)
# Configs are deployed from odc-onboard-v2/configs/ to /etc/odc-onboard/vpn/ at test start.
export ODC_WG_CONFIGS="/etc/odc-onboard/vpn/dev.conf,/etc/odc-onboard/vpn/remote.conf"
export ODC_WG_IDS="vpn_wg_dev,vpn_wg_remote"

# OpenVPN clients (comma-separated paths and ids, same order)
export ODC_OVPN_CONFIGS="/etc/odc-onboard/vpn/dev.ovpn,/etc/odc-onboard/vpn/remote.ovpn"
export ODC_OVPN_IDS="vpn_ovpn_dev,vpn_ovpn_remote"

# MAVLink hardware
export ODC_MAVLINK_DEVICE=/dev/ttyACM0
export ODC_MAVLINK_BAUD=1500000

# RTSP ports per compressor (input = video-source, output = monitor target)
export ODC_RTSP_INPUT_PORTS="8554,8556"
export ODC_RTSP_OUTPUT_PORTS="8555,8557"

# Set CLEANUP_CONFIG=1 to remove ODC_CONFIG after suite (default: keep for next run)
# export CLEANUP_CONFIG=0
