sequenceDiagram
    autonumber
    participant CELL as cellular0
    participant VPN as vpn_cloud
    participant EB as EventBus
    participant TE as TriggerEvaluator
    participant LE as LinkEngine
    participant MAVE as mav_ext_cloud
    participant RTSP as rtsp_cloud
    participant MAVR as mav_primary

    CELL->>VPN: wan binding ready
    VPN->>VPN: WireGuard handshake
    VPN->>EB: VpnStateChangeEvent Connected
    VPN->>EB: TransportBindingEvent ip_ready=false
    EB->>TE: vpn.connected from vpn_cloud
    TE->>LE: activate cloud_mavlink, cloud_rtsp
    VPN->>EB: TransportBindingEvent ip_ready=true
    LE->>MAVE: propagate binding via cloud_mavlink
    LE->>RTSP: propagate binding via cloud_rtsp
    MAVR->>MAVE: router_ref via router_to_ext_cloud
    MAVE->>MAVE: start UDP extender on tunnel IP
    RTSP->>RTSP: start RtspBridge input_uri from binding
    MAVE->>EB: MavExtenderStatusEvent connected
    RTSP->>EB: RtspCompressorStatusEvent running
