erDiagram
    SYSTEM_YAML ||--|{ COMPONENT : contains
    SYSTEM_YAML ||--|{ LINK : contains
    SYSTEM_YAML ||--|{ TRIGGER : contains

    COMPONENT ||--o{ LINK : "from.port"
    COMPONENT ||--o{ LINK : "to.port"
    TRIGGER }o--|| COMPONENT : source
    TRIGGER ||--|{ LINK : activate
    TRIGGER ||--|{ LINK : deactivate

    COMPONENT {
        string id PK
        string type
        bool enabled
        json config
    }

    LINK {
        string id PK
        string from_component FK
        string from_port
        string to_component FK
        string to_port
        json bind_fields
    }

    TRIGGER {
        string id PK
        string on_event
        string source_component FK
        string[] activate_links
        string[] deactivate_links
    }

    TRANSPORT_BINDING {
        string connection_id
        string interface_name
        string target_ip
        int prefix_len
        string vpn_state
        bool ip_ready
    }

    LINK ||--|| TRANSPORT_BINDING : propagates
