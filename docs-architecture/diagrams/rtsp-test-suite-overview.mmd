flowchart TB
    Start([Start Test Suite]) --> S1

    subgraph S1["1. Source Code Verification"]
        V1[Check headers exist]
        V2[Check events in variant]
        V3[Check IPC methods registered]
        V4[Check CLI commands]
        V1 --> V2 --> V3 --> V4
    end

    S1 --> S2

    subgraph S2["2. CLI Help & Parsing"]
        C1[rtsp help lists commands]
        C2[rtsp start/stop usage]
        C3[Missing args shows error]
        C1 --> C2 --> C3
    end

    S2 --> S3

    subgraph S3["3. Hardware Detection"]
        H1[detectHardware output]
        H2[Verify arch / GStreamer ver]
        H3[Verify CPU / RAM fields]
        H4[Verify strategy enum]
        H1 --> H2 --> H3 --> H4
    end

    S3 --> S4

    subgraph S4["4. Config Generation"]
        G1[Generate enabled+auto config]
        G2[Generate disabled config]
        G3[Generate manual-only config]
        G4[Default config (no rtsp key)]
        G1 --> G2 --> G3 --> G4
    end

    S4 --> S5

    subgraph S5["5. Daemon — Disabled"]
        D1[Start daemon rtsp:false]
        D2[rtsp status → not configured]
        D3[rtsp start → rejected]
        D4[Stop daemon cleanly]
        D1 --> D2 --> D3 --> D4
    end

    S5 --> S6

    subgraph S6["6. Daemon — Enabled + Auto-Spawn"]
        A1[Start daemon rtsp:true]
        A2[Create TUN iface + assign IP]
        A3[Sleep 4s wait for spawn]
        A4[rtsp status → running]
        A5[Remove IP → auto-teardown]
        A6[Cleanup TUN + stop daemon]
        A1 --> A2 --> A3 --> A4 --> A5 --> A6
    end

    S6 --> S7

    subgraph S7["7. Manual CLI Operations"]
        M1[rtsp start conn1 iface ip]
        M2[rtsp status → conn1 listed]
        M3[rtsp start conn1 again → no-op]
        M4[rtsp stop conn1 → stopped]
        M5[rtsp stop nonexistent → no crash]
        M1 --> M2 --> M3 --> M4 --> M5
    end

    S7 --> S8

    subgraph S8["8. IPC Methods"]
        I1[Verify 3 methods in source]
        I2[rtsp.status via CLI JSON]
        I3[rtsp.start via CLI]
        I4[rtsp.stop via CLI]
        I1 --> I2 --> I3 --> I4
    end

    S8 --> S9

    subgraph S9["9. Auto-Spawn Lifecycle"]
        L1[AddressAdded IPv4 → spawn]
        L2[2nd AddressAdded → no duplicate]
        L3[AddressRemoved → teardown]
        L4[AddressAdded empty IP → no spawn]
        L5[InterfaceUp only → no spawn]
        L6[InterfaceCreated only → no spawn]
        L7[VpnState::Disconnected → teardown]
        L1 --> L2 --> L3 --> L4 --> L5 --> L6 --> L7
    end

    S9 --> S10

    subgraph S10["10. Auto-Spawn Disabled"]
        X1[auto_start_on_vpn=false]
        X2[AddressAdded → NO spawn]
        X3[Manual start still works]
        X4[AddressRemoved → teardown]
        X1 --> X2 --> X3 --> X4
    end

    S10 --> S11

    subgraph S11["11. Multiple Compressors"]
        P1[Create 3 TUN ifaces with IPs]
        P2[rtsp status → 3 instances]
        P3[Teardown middle one]
        P4[2 remain, A and C]
        P5[Teardown all → 0 remain]
        P1 --> P2 --> P3 --> P4 --> P5
    end

    S11 --> S12

    subgraph S12["12. Graceful Shutdown"]
        SH1[Spawn compressor on TUN]
        SH2[SIGTERM daemon]
        SH3[Socket removed]
        SH4[TUN device survives]
        SH1 --> SH2 --> SH3 --> SH4
    end

    S12 --> S13

    subgraph S13["13. End-to-End Video Pipeline"]
        E1[Start odc-video-source on port 19554]
        E2[Start daemon with rtsp config]
        E3[Trigger compressor via loopback IP]
        E4[odc-rtsp-monitor connects to output]
        E5[Verify bandwidth > 0]
        E6[Stop compressor + video source]
        E1 --> E2 --> E3 --> E4 --> E5 --> E6
    end

    S13 --> S14

    subgraph S14["14. Build Verification"]
        B1[ldd: libgstrtspserver linked]
        B2[ldd: libgstreamer linked]
        B3[Binary > 12MB with cmpr]
        B4[Symbols: RtspBridge present]
        B1 --> B2 --> B3 --> B4
    end

    S14 --> S15

    subgraph S15["15. Thread Safety"]
        T1[Rapid start/stop 5 cycles]
        T2[3 simultaneous spawns]
        T3[Cleanup all interfaces]
        T1 --> T2 --> T3
    end

    S15 --> End([Print Results Summary])
