flowchart TB
    subgraph ConfigAuto["config.json: auto_start_on_vpn = true"]
        A1["User starts daemon with auto=true"]
        A2["User creates TUN interface wg-autotest"]
        A3["User assigns IP 10.77.5.1/24"]
        A4["Wait 5s — VpnInterfaceMonitor detects netlink event"]
        A5["EventBus fires VpnInterfaceEvent{AddressAdded}"]
        A6["RtspCompressorManager receives event"]
        A7["spawn_compressor(conn_id, iface, ip)"]
        A8["rtsp status → compressor running"]
        A9["User removes IP → teardown"]
        A10["rtsp status → no compressors"]

        A1 --> A2 --> A3 --> A4 --> A5 --> A6 --> A7 --> A8 --> A9 --> A10
    end

    subgraph ConfigManual["config.json: auto_start_on_vpn = false"]
        M1["User starts daemon with auto=false"]
        M2["User creates TUN interface wg-manual"]
        M3["User assigns IP 10.77.6.1/24"]
        M4["Wait 5s — no auto-spawn"]
        M5["rtsp status → no compressors"]
        M6["User runs: rtsp start manualtest wg-manual 10.77.6.1"]
        M7["Compressor starts — manual path works"]
        M8["rtsp status → compressor running"]
        M9["User runs: rtsp stop manualtest"]
        M10["Compressor torn down"]

        M1 --> M2 --> M3 --> M4 --> M5 --> M6 --> M7 --> M8 --> M9 --> M10
    end

    style ConfigAuto fill:#1a2b1a,stroke:#3a5
    style ConfigManual fill:#2a1a1a,stroke:#a53
