<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.odc.hook</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/odc-hook</string>
        <string>--config</string>
        <string>/usr/local/etc/odc-root/odc-hook.yaml</string>
        <string>--daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/odc-hook.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/odc-hook.log</string>
</dict>
</plist>
