flowchart TD
    subgraph EventBus
        VSCE["VpnStateChangeEvent{Connected}"]
        VIE["VpnInterfaceEvent{AddressAdded}"]
    end

    subgraph VpnTunnelComponent
        ON_EVENT["on_event()"]
        ON_VSC["on_vpn_state_change()"]
        EMIT_B1["emit_binding()"]
    end

    subgraph GraphRuntime
        GR_EVENT["on_event()"]
    end

    subgraph TriggerEvaluator
        ON_CONN["on_vpn_connected()"]
        ON_IP["on_vpn_ip_ready()"]
        AVL1["activate_vpn_links() BUG"]
        AVL2["activate_vpn_links() BUG"]
        FINISH1["finish_vpn_ip_ready()"]
        FINISH2["finish_vpn_ip_ready() BUG"]
    end

    subgraph Downstream
        ARM1["arm_link_targets()"]
        ARM2["arm_link_targets()"]
        START1["start() targets"]
        START2["start() targets"]
        PROPAGATE["propagate(binding)"]
    end

    VSCE -->|"path A"| GR_EVENT
    GR_EVENT --> ON_CONN
    ON_CONN --> AVL1
    ON_CONN -->|"ip_ready==true?"| FINISH1
    AVL1 --> ARM1

    VSCE -->|"also received by"| ON_EVENT
    ON_EVENT --> ON_VSC
    ON_VSC -->|"ip_ready=false"| EMIT_B1
    EMIT_B1 -->|"callback blocked"| X0["early return"]

    VIE --> ON_EVENT
    ON_EVENT -->|"AddressAdded"| EMIT_B2["emit_binding()"]
    EMIT_B2 -->|"ip_ready=true"| ON_IP
    ON_IP --> AVL2
    ON_IP --> FINISH2
    AVL2 --> ARM2
    FINISH2 --> START2
    FINISH2 --> PROPAGATE

    FINISH1 --> START1
    FINISH1 --> PROPAGATE

    ARM1 -.->|"DUPLICATE on edge case"| ARM2
    START1 -.->|"DUPLICATE"| START2
