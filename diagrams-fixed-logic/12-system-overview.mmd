flowchart TB
    subgraph Config["Configuration"]
        YAML["system.yaml\nversion:2, components, links, triggers"]
        YAML --> DETECT["detect_config_format()"]
        DETECT --> LOAD["load_graph_schema()\n(yaml_to_json)"]
    end

    subgraph Runtime["GraphRuntime"]
        LOAD --> SCHEMA["GraphSchema"]
        SCHEMA --> VALIDATE["GraphValidator"]
        VALIDATE --> BUILD["build_runtime_locked()"]

        BUILD --> CIRCUIT["CircuitRegistry\nDSPatch::Circuit"]
        BUILD --> LINK_ENG["LinkEngine\ngate controller"]
        BUILD --> TRIG_EVAL["TriggerEvaluator\nevent to link"]

        CIRCUIT --> CELL_WAN["CellularWanComponent"]
        CELL_WAN --> VPN_TUN["VpnTunnelComponent"]
        VPN_TUN --> MAV_EXT["MavExtenderComponent"]
        VPN_TUN --> RTSP_CMP["RtspCompressorComponent"]
        MAV_ROUTER["MavRouterComponent"] --> MAV_EXT

        LINK_ENG -->|"ConnectOutToIn"| CIRCUIT
        LINK_ENG -->|"DisconnectInput"| CIRCUIT

        TRIG_EVAL -->|"activate"| LINK_ENG
        TRIG_EVAL -->|"deactivate"| LINK_ENG
    end

    subgraph IPC["IPC Layer"]
        METHOD["graph.* JSON-RPC"]
        METHOD --> STATUS["graph.status"]
        METHOD --> MUTATE["graph.components.*"]
        METHOD --> TOPO["graph.links.* triggers.set"]
        METHOD --> RECONCILE["graph.apply"]
        MUTATE --> PERSIST["PersistenceManager\natomic write"]
        TOPO --> PERSIST
        RECONCILE --> PERSIST
    end

    subgraph EventBus["EventBus"]
        VSCE["VpnStateChangeEvent"] --> GR_EVENT["on_event()"]
        QMI["QmiConnectionEvent"] --> GR_EVENT
        HEALTH["VpnHealthCheckEvent"] --> GR_EVENT
        GR_EVENT --> TRIG_EVAL
    end

    CIRCUIT -.->|"tick 100ms"| PROCESS["Process_() propagates\nTransportBinding through buses"]

    style YAML fill:#6f6,stroke:#0f0
    style RECONCILE fill:#6f6,stroke:#0f0
    style PERSIST fill:#6cf,stroke:#06f
    style LINK_ENG fill:#f9f,stroke:#f0f
