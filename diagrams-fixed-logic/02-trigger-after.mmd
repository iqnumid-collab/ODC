flowchart TD
    subgraph EventBus
        VSCE["VpnStateChangeEvent{Connected}"]
        VIE["VpnInterfaceEvent{AddressAdded}"]
    end

    subgraph GraphRuntime
        GR_EVENT["on_event()"]
    end

    subgraph TriggerEvaluator
        ON_CONN["on_vpn_connected()"]
        ON_IP["on_vpn_ip_ready()"]
        COLLECT{"collect_active_link_ids()"}
        AVL["activate_vpn_links()"]
        FINISH["finish_vpn_ip_ready()"]
        PROP["propagate_vpn_binding()"]
        GUARD{"state != Running?"}
    end

    subgraph LinkEngine
        ACTIVATE["activate_link()"]
    end

    subgraph Downstream
        ARM["arm_link_targets()"]
        START["start() targets"]
    end

    VSCE --> GR_EVENT
    GR_EVENT --> ON_CONN
    ON_CONN --> AVL
    AVL --> ACTIVATE
    AVL --> ARM
    ON_CONN -->|"ip_ready==true?"| FINISH
    FINISH --> ACTIVATE
    FINISH --> GUARD
    GUARD -->|"yes"| START
    GUARD -->|"no: skip"| SKIP["skip"]

    VIE -->|"path B"| ON_IP
    ON_IP --> COLLECT
    COLLECT -->|"no active links"| AVL2["activate_vpn_links()"]
    COLLECT -->|"links active"| PROP
    AVL2 --> FINISH
    PROP --> LE_PROP["link_engine->propagate()"]

    ARM -.->|"called once"| ARM_OK["idempotent"]
    START -.->|"guarded"| START_OK["guarded"]
