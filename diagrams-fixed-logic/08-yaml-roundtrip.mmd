flowchart TD
    subgraph load["load_graph_schema()"]
        YAML_FILE["system.yaml"] --> YAML_PARSE["yaml-cpp::LoadFile()"]
        YAML_PARSE --> YAML_NODE["YAML::Node root"]
        YAML_NODE -->|"config node"| Y2J["yaml_to_json()"]
        Y2J --> JSON_OBJ["nlohmann::json config"]
        JSON_OBJ --> SCHEMA["GraphSchema"]
    end

    subgraph internal["Internal"]
        SCHEMA --> NLJSON["config as nlohmann::json"]
    end

    subgraph save["save_graph_schema()"]
        NLJSON --> J2Y["json_to_yaml()"]
        J2Y --> YAML_BUILD["YAML::Node builder"]
        YAML_BUILD --> YAML_EMIT["YAML::Emitter"]
        YAML_EMIT --> TMP[".tmp file"]
        TMP --> BAK[".bak backup"]
        BAK --> RENAME["rename .tmp to target"]
    end

    subgraph disk["On Disk"]
        RENAME --> RESULT["system.yaml\n  config:\n    output_port: 8555\n    input_port: 8554"]
    end

    style RESULT fill:#6f6,stroke:#0f0
    style Y2J fill:#6cf,stroke:#06f
    style J2Y fill:#6cf,stroke:#06f
