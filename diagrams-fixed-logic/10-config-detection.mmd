    SCAN -->|"no"| LEGACY

    GRAPH --> APP["graph_mode_ = true"]
    LEGACY --> APP2["graph_mode_ = false"]

    APP --> LOAD["load_graph_schema()"]
    APP2 --> LOAD2["legacy managers"]
